{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MahyarVPN",
  "mainBinaryName": "mahyarvpn",
  "version": "2.5.0",
  "identifier": "com.mahyar.vpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MahyarVPN",
        "width": 1080,
        "height": 700,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "minWidth": 420,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/sing-box.exe": "sing-box.exe",
      "bin/aether/*": "aether/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}